# Curevan backend environment. Copy to .env and fill in. Never commit real values.

# Server
NODE_ENV=            # development | production
PORT=                # API port, e.g. 5000
FRONTEND_URL=        # website base URL used in e-mail links, e.g. https://curevan.com
CORS_ORIGINS=        # comma-separated allowed origins, e.g. https://curevan.com,https://www.curevan.com

# PostgreSQL
DB_HOST=             # database host
DB_PORT=             # database port, usually 5432
DB_NAME=             # database name
DB_USER=             # database user
DB_PASSWORD=         # database password

# Auth
JWT_SECRET=          # long random string used to sign login tokens
JWT_EXPIRE=          # token lifetime, e.g. 1d
GOOGLE_CLIENT_ID=    # Google OAuth client id
GOOGLE_CLIENT_SECRET= # Google OAuth client secret

# Firebase Admin (push notifications). Either keep firebase-service-account.json outside git, or:
FIREBASE_SERVICE_ACCOUNT=  # service-account JSON as a single-line string
FIREBASE_SERVICE_ACCOUNT_PATH= # or: path to the service-account JSON file kept OUTSIDE the repo

# E-mail (Gmail SMTP until a transactional provider is added)
MAIL_USER=           # sender account
MAIL_PASS=           # app password for the sender account
MAIL_FROM=           # visible sender address; falls back to MAIL_USER

# Razorpay (use TEST keys outside production)
RAZORPAY_KEY_ID=       # public key id, also sent to the browser at checkout
RAZORPAY_KEY_SECRET=   # secret, server only - signs and verifies payments
RAZORPAY_WEBHOOK_SECRET= # secret you set when adding the webhook in the Razorpay dashboard

# Shiprocket
SHIPROCKET_API_EMAIL=     # Shiprocket API user e-mail
SHIPROCKET_API_PASSWORD=  # Shiprocket API user password
SHIPROCKET_PICKUP_LOCATION= # pickup location name configured in Shiprocket

# AI
AI_MODEL_ID=         # current Gemini model id, set at go-live

# Booking flow (handoff pack P07): false (default) = patient pays immediately; true = optional therapist-approval-first flow
DIRECT_BOOKING_NEEDS_APPROVAL=false

# Public base URL of this API (used to build links to uploaded media)
NEXT_PUBLIC_API_URL=

# Shiprocket courier webhook (see docs/SHIPROCKET_SETUP.md)
SHIPROCKET_WEBHOOK_TOKEN=

# Start-code (OTP) signing; optional, falls back to JWT_SECRET
OTP_SECRET=

# Notifications (P24): console (default, logs only) | meta | msg91 | sendgrid. Leave empty to keep a channel off.
MAIL_PROVIDER=        # smtp (MAIL_USER/MAIL_PASS) or sendgrid
SENDGRID_API_KEY=
WHATSAPP_PROVIDER=    # console | meta
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
SMS_PROVIDER=         # console | msg91
SMS_AUTH_KEY=
MSG91_AUTH_KEY=
DLT_ENTITY_ID=
DLT_SENDER_ID=
DLT_TID_BOOKING_CONFIRMED=
DLT_TID_REMINDER_24H=
DLT_TID_REMINDER_2H=
DLT_TID_SOS=
ONCALL_PHONE=         # receives SOS alerts

# Masked calling (P27): exotel | console | empty = off
TELEPHONY_PROVIDER=
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=
EXOTEL_VIRTUAL_NUMBER=
TELEPHONY_STATUS_CALLBACK_URL=
TELEPHONY_WEBHOOK_TOKEN=

# Folder for private files (PDFs, uploads); must persist across deploys
PRIVATE_STORAGE_DIR=
